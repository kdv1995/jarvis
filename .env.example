# Jarvis — local secrets and configuration.
#
# Copy this file to `.env` in this same directory (the project root) and fill
# in your values. `.env` is git-ignored; `.env.example` is the committed
# template. Jarvis loads `.env` at startup via dotenvy.
#
# TTS is local Kokoro (`kokoro-tts/server.py`) and does not need ElevenLabs.
# STT uses local Whisper first (`whisper-stt/server.py`) and falls back to
# ElevenLabs Scribe when the local server is down or JARVIS_STT_ENGINE=elevenlabs.

# --- ElevenLabs STT fallback -----------------------------------------------
# API key — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional — choose STT engine: whisper (default) or elevenlabs.
# JARVIS_STT_ENGINE=whisper

# Optional — force recognition language: auto, en, uk, ru, etc.
# JARVIS_STT_LANG=auto

# Optional — local Whisper model and beam size.
# JARVIS_WHISPER_MODEL=small
# JARVIS_WHISPER_BEAM=1

# Optional — microphone and TTS interaction tuning.
# JARVIS_MIC_DEVICE=
# Clap wake is intentionally easy by default: one confirmed clap wakes Jarvis.
# Set to double if your room causes false wakes.
# JARVIS_CLAP_WAKE_MODE=single
# JARVIS_MIC_PAUSE_DURING_TTS=true
# JARVIS_WAKE_ACK=Yes?
# JARVIS_LAUNCH_WAKE_GREETING=Jarvis online.

# Optional — premium TTS. With ELEVENLABS_API_KEY set, Jarvis uses ElevenLabs
# by default and falls back to Kokoro on failure. Force local with kokoro.
# JARVIS_TTS_ENGINE=elevenlabs
# JARVIS_ELEVENLABS_TTS_VOICE_ID=h9NSQvWZaC4NFusYsxT9
# JARVIS_ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
# JARVIS_TTS_LANG=uk
